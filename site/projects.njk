---
layout: base.njk
title: Top Community Projects
permalink: /projects/
---

<div class="text-center py-12">
    <h1 class="text-4xl md:text-6xl font-extrabold mb-4">Community Projects</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">Discover the most popular open-source repositories built by Bangladeshi developers.</p>
</div>

<div class="max-w-6xl mx-auto mb-12">
    <!-- Controls Container -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-700 mb-8">
        <div class="flex flex-col md:flex-row gap-4 mb-6">
            <div class="relative flex-grow">
                <input type="text" id="project-search" placeholder="Search by name or description..." 
                       class="w-full pl-12 pr-4 py-4 rounded-2xl bg-gray-50 dark:bg-slate-900 border-none focus:ring-2 focus:ring-primary outline-none text-lg">
                <div class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
            <div class="flex gap-4">
                <select id="project-sort" class="px-6 py-4 rounded-2xl bg-gray-50 dark:bg-slate-900 border-none focus:ring-2 focus:ring-primary outline-none font-medium">
                    <option value="stars">Most Stars</option>
                    <option value="forks">Most Forks</option>
                    <option value="name">Alphabetical</option>
                </select>
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400">Filter by Language</h3>
                <button id="clear-filters" class="text-sm text-primary font-bold hover:underline hidden">Clear All</button>
            </div>
            <div id="language-filters" class="flex flex-wrap gap-2">
                <!-- Language chips populated by JS -->
                <div class="animate-pulse flex gap-2">
                    <div class="h-8 w-20 bg-gray-100 dark:bg-gray-700 rounded-full"></div>
                    <div class="h-8 w-24 bg-gray-100 dark:bg-gray-700 rounded-full"></div>
                    <div class="h-8 w-16 bg-gray-100 dark:bg-gray-700 rounded-full"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Info -->
    <div id="project-results-info" class="mb-6 px-2 text-gray-500 font-medium hidden">
        <span id="project-count">0</span> projects found
    </div>

    <!-- Results Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Projects populated by JS -->
    </div>

    <!-- Sentinel for Lazy Loading -->
    <div id="load-more-sentinel" class="h-20 flex items-center justify-center">
        <div id="loading-spinner" class="hidden animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    </div>

    <!-- Empty State -->
    <div id="no-results" class="hidden text-center py-20">
        <div class="text-6xl mb-4">🔍</div>
        <h2 class="text-2xl font-bold mb-2">No projects found</h2>
        <p class="text-gray-500">Try adjusting your search or filters</p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
<script src="/assets/projects.js"></script>

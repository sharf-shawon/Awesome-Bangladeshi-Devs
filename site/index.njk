---
layout: base.njk
title: Home
---

<div class="text-center py-12">
    <h1 class="text-4xl md:text-6xl font-extrabold mb-4">
        Discover <span class="text-primary">{{ stats.total_devs | localeString }}</span> Bangladeshi GitHub Developers
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        A curated, data-driven list of the most active developers from Bangladesh.
    </p>
</div>

<div class="max-w-3xl mx-auto mb-12 sticky top-20 z-40">
    <div class="relative">
        <input type="text" id="search-input" placeholder="Search by name, username, bio, or language..." 
               class="w-full px-6 py-4 rounded-2xl border-2 border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 text-lg focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all shadow-xl">
        <div id="search-results-count" class="absolute right-6 top-1/2 -translate-y-1/2 text-gray-400"></div>
    </div>
</div>

<div id="default-content">
    <section class="mb-16">
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <span class="w-2 h-8 bg-primary rounded-full"></span>
            Top Contributors
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for dev in enriched | sortBy("activity_score") | limit(6) %}
                <a href="/dev/{{ dev.github_username | lower }}/" class="group block p-6 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary transition-all hover:shadow-lg bg-white dark:bg-slate-800">
                    <div class="flex items-center gap-4 mb-4">
                        <img src="{{ dev.avatar_url }}" alt="{{ dev.github_username }}" class="w-16 h-16 rounded-full border-2 border-primary/20 group-hover:scale-105 transition-transform">
                        <div>
                            <h3 class="font-bold text-lg group-hover:text-primary transition-colors">{{ dev.name }}</h3>
                            <p class="text-gray-500 text-sm">@{{ dev.github_username }}</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 mb-4">
                        {% if dev.top_language %}
                            <span class="px-2 py-1 bg-primary/10 text-primary text-xs font-medium rounded-md">{{ dev.top_language }}</span>
                        {% endif %}
                    </div>
                    <div class="grid grid-cols-3 gap-2 text-center text-sm border-t border-gray-100 dark:border-gray-700 pt-4">
                        <div>
                            <div class="font-bold">{{ dev.activity_score }}</div>
                            <div class="text-xs text-gray-400">Score</div>
                        </div>
                        <div>
                            <div class="font-bold">{{ dev.followers }}</div>
                            <div class="text-xs text-gray-400">Followers</div>
                        </div>
                        <div>
                            <div class="font-bold">{{ dev.total_stars }}</div>
                            <div class="text-xs text-gray-400">Stars</div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
        <div class="text-center mt-10">
            <a href="/all/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-colors shadow-lg">
                View All Developers
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
        </div>
    </section>
</div>

<div id="search-results" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
    <!-- Results populated by JS -->
</div>

<!-- Sentinel for Lazy Loading -->
<div id="load-more-sentinel" class="h-20 flex items-center justify-center">
    <div id="loading-spinner" class="hidden animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
</div>

<script>
    let fuse;
    let allDevs = [];
    const searchInput = document.getElementById('search-input');
    const defaultContent = document.getElementById('default-content');
    const searchResults = document.getElementById('search-results');
    const resultsCount = document.getElementById('search-results-count');
    const sentinel = document.getElementById('load-more-sentinel');
    const loadingSpinner = document.getElementById('loading-spinner');

    // Batch rendering state
    const BATCH_SIZE = 48;
    let currentIndex = 0;
    let isLazyLoadingEnabled = true;

    function createDevCard(item) {
        return `
            <a href="/dev/${item.u.toLowerCase()}/" class="group block p-6 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary transition-all hover:shadow-lg bg-white dark:bg-slate-800">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-xl font-bold text-primary overflow-hidden">
                        ${item.u[0].toUpperCase()}
                    </div>
                    <div>
                        <h3 class="font-bold text-lg group-hover:text-primary transition-colors">${item.n || item.u}</h3>
                        <p class="text-gray-500 text-sm">@${item.u}</p>
                    </div>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-4 h-10">${item.b || 'No bio available'}</p>
                <div class="flex flex-wrap gap-2 mb-4">
                    ${item.l ? `<span class="px-2 py-1 bg-primary/10 text-primary text-xs font-medium rounded-md">${item.l}</span>` : ''}
                </div>
                <div class="grid grid-cols-3 gap-2 text-center text-sm border-t border-gray-100 dark:border-gray-700 pt-4">
                    <div>
                        <div class="font-bold">${item.s}</div>
                        <div class="text-xs text-gray-400">Score</div>
                    </div>
                    <div>
                        <div class="font-bold">${item.f}</div>
                        <div class="text-xs text-gray-400">Followers</div>
                    </div>
                    <div>
                        <div class="font-bold">${item.r}</div>
                        <div class="text-xs text-gray-400">Repos</div>
                    </div>
                </div>
            </a>
        `;
    }

    function renderNextBatch() {
        if (!isLazyLoadingEnabled || currentIndex >= allDevs.length) {
            loadingSpinner.classList.add('hidden');
            return;
        }

        loadingSpinner.classList.remove('hidden');
        const nextBatch = allDevs.slice(currentIndex, currentIndex + BATCH_SIZE);
        
        const fragment = document.createDocumentFragment();
        const container = document.createElement('div');
        container.innerHTML = nextBatch.map(item => createDevCard(item)).join('');
        
        while (container.firstChild) {
            fragment.appendChild(container.firstChild);
        }

        searchResults.appendChild(fragment);
        currentIndex += BATCH_SIZE;
        
        if (currentIndex >= allDevs.length) {
            loadingSpinner.classList.add('hidden');
        }
    }

    // Fetch search index
    fetch('/data/search-index.json')
        .then(res => res.json())
        .then(data => {
            allDevs = data.sort((a, b) => b.s - a.s);
            fuse = new Fuse(allDevs, {
                keys: ['u', 'n', 'b', 'l', 'al', 't'],
                threshold: 0.3,
                includeScore: true
            });

            // Setup Infinite Scroll
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    renderNextBatch();
                }
            }, { rootMargin: '200px' });
            
            observer.observe(sentinel);
        });

    searchInput.addEventListener('input', (e) => {
        const query = e.target.value;
        
        if (query.length < 2) {
            defaultContent.classList.remove('hidden');
            searchResults.innerHTML = '';
            currentIndex = 0;
            isLazyLoadingEnabled = true;
            renderNextBatch();
            searchResults.classList.remove('hidden'); // Show lazy loaded devs by default when no search
            resultsCount.textContent = '';
            return;
        }

        isLazyLoadingEnabled = false;
        loadingSpinner.classList.add('hidden');
        const results = fuse.search(query);
        defaultContent.classList.add('hidden');
        searchResults.classList.remove('hidden');
        resultsCount.textContent = `${results.length} found`;

        searchResults.innerHTML = results.map(({ item }) => createDevCard(item)).join('');
    });
</script>

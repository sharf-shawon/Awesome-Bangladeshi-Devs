<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Awesome Bangladeshi Devs" }}</title>
  <meta name="description" content="{{ description or 'Discover and explore the work of talented Bangladeshi developers on GitHub.' }}">
  
  <!-- SEO -->
  <link rel="canonical" href="https://awesome-bangladeshi-devs.shawon.me{{ page.url }}">
  <meta property="og:title" content="{{ title or 'Awesome Bangladeshi Devs' }}">
  <meta property="og:description" content="{{ description or 'Discover and explore the work of talented Bangladeshi developers on GitHub.' }}">
  <meta property="og:url" content="https://awesome-bangladeshi-devs.shawon.me{{ page.url }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=GOOGLE_ANALYTICS_ID"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'GOOGLE_ANALYTICS_ID');
  </script>
</head>
<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans">
  <header class="border-b dark:border-gray-800 py-4 mb-8">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <a href="{{ '/' | url }}" class="text-xl font-bold">Awesome Bangladeshi Devs</a>
      <nav>
        <ul class="flex flex-wrap items-center gap-4 md:gap-6 text-sm md:text-base">
          <li><a href="{{ '/' | url }}" class="hover:text-blue-500 font-medium">Directory</a></li>
          <li><a href="{{ '/projects/' | url }}" class="hover:text-blue-500 font-medium">Projects</a></li>
          <li><a href="{{ '/stats/' | url }}" class="hover:text-blue-500 font-medium">Stats</a></li>
          <li><a href="{{ '/languages/' | url }}" class="hover:text-blue-500 font-medium">Languages</a></li>
          <li><a href="https://github.com/sharf-shawon/Awesome-Bangladeshi-Devs" target="_blank" class="px-4 py-2 bg-black dark:bg-white text-white dark:text-black rounded-lg text-sm font-bold hover:opacity-80 transition-all">GitHub</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container mx-auto px-4">
    {{ content | safe }}
  </main>

  <footer class="mt-16 py-8 border-t dark:border-gray-800 text-center text-gray-500 text-sm">
    <p>&copy; {{ "" | readableDate }} Awesome Bangladeshi Devs. Created by the community.</p>
  </footer>

  <script>
    window.pathPrefix = "{{ '/' | url }}";
  </script>
  <script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {% set current_title = title or "Awesome Bangladeshi Devs" %}
    {% if current_title != "Home" %}
        {% set current_title = current_title + " | Awesome Bangladeshi Devs" %}
    {% else %}
        {% set current_title = "Awesome Bangladeshi Devs | Discovery Platform for Bangladeshi Developers" %}
    {% endif %}
    
    <title>{{ current_title }}</title>
    
    {% set current_description = seo_description or description or "Discover the most active and talented GitHub developers from Bangladesh. Community-driven directory, rankings, and community projects." %}
    <meta name="description" content="{{ current_description }}">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ current_title }}">
    <meta property="og:description" content="{{ current_description }}">
    <meta property="og:image" content="{{ site.url }}/assets/og-image.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="{{ site.url }}{{ page.url }}">
    <meta property="twitter:title" content="{{ current_title }}">
    <meta property="twitter:description" content="{{ current_description }}">
    <meta property="twitter:image" content="{{ site.url }}/assets/og-image.png">

    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    
    <!-- Tailwind v4 CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Fuse.js -->
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7/dist/fuse.min.js"></script>
    
    <style type="text/tailwindcss">
        @theme {
            --color-primary: #006a4e; /* Bangladesh Green */
            --color-secondary: #f42a41; /* Bangladesh Red */
        }
        
        [data-theme='dark'] {
            background-color: #0f172a;
            color: #f8fafc;
        }
    </style>
    
    <script>
        // Theme initialization
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
        }
        
        function toggleTheme() {
            const html = document.documentElement;
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', newTheme);
            localStorage.theme = newTheme;
        }
    </script>
</head>
<body class="min-h-screen transition-colors duration-200">
    <header class="border-b border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-50">
        <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
            <a href="/" class="text-xl font-bold flex items-center gap-2">
                <span class="text-primary">Awesome</span>
                <span>Bangladeshi Devs</span>
            </a>
            
            <div class="hidden md:flex items-center gap-6">
                <a href="/" class="hover:text-primary transition-colors">Home</a>
                <a href="/all/" class="hover:text-primary transition-colors">Developers</a>
                <a href="/languages/" class="hover:text-primary transition-colors">Languages</a>
                <a href="/stats/" class="hover:text-primary transition-colors">Stats</a>
                <a href="/projects/" class="hover:text-primary transition-colors">Projects</a>
            </div>
            
            <div class="flex items-center gap-4">
                <button onclick="toggleTheme()" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle theme">
                    <svg id="theme-icon-light" class="hidden dark:block w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 5a7 7 0 100 14 7 7 0 000-14z"></path></svg>
                    <svg id="theme-icon-dark" class="block dark:hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
                <a href="https://github.com/sharf-shawon/Awesome-Bangladeshi-Devs" class="hidden sm:block p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="GitHub">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
            </div>
        </nav>
    </header>

    <main class="container mx-auto px-4 py-8">
        {{ content | safe }}
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-700 mt-20 py-10 bg-gray-50 dark:bg-slate-900/50">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-600 dark:text-gray-400">
                Community-driven directory of Bangladeshi Developers.
            </p>
            <div class="mt-4 flex justify-center gap-6 text-sm text-gray-500">
                <span>Total Devs: {{ stats.total_devs }}</span>
                <span>Last Updated: {{ stats.last_updated | readableDate }}</span>
            </div>
        </div>
    </footer>

    <!-- GA: GOOGLE_ANALYTICS_ID -->
</body>
</html>

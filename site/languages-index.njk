---
layout: base.njk
title: Programming Languages
permalink: /languages/
---

<div class="text-center py-12">
    <h1 class="text-4xl md:text-6xl font-extrabold mb-4">Programming Languages</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400">
        Popular languages used by the Bangladeshi developer community.
    </p>
</div>

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-20">
    {% for lang in languages %}
    <a href="/languages/{{ lang.slug }}/" class="group p-6 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary bg-white dark:bg-slate-800 transition-all hover:shadow-lg">
        <h2 class="text-xl font-bold group-hover:text-primary transition-colors mb-2">{{ lang.name }}</h2>
        <div class="flex items-end justify-between">
            <span class="text-3xl font-black opacity-20 group-hover:opacity-100 transition-opacity">{{ lang.count }}</span>
            <span class="text-xs text-gray-400 uppercase tracking-widest">Developers</span>
        </div>
    </a>
    {% endfor %}
</div>

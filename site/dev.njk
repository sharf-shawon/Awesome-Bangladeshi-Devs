---
layout: base.njk
pagination:
    data: enriched
    size: 1
    alias: dev
permalink: "/dev/{{ dev.github_username | lower }}/"
eleventyComputed:
    title: "{{ dev.name }} (@{{ dev.github_username }})"
    seo_description: "{{ dev.name }} (@{{ dev.github_username }}) is a GitHub developer from {{ dev.location or 'Bangladesh' }} with {{ dev.total_stars | localeString }} stars and {{ dev.followers | localeString }} followers. Top language: {{ dev.top_language or 'None' }}."
---

<div class="max-w-4xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-3xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-xl mb-8">
        <div class="h-32 bg-gradient-to-r from-primary to-secondary"></div>
        <div class="px-8 pb-8">
            <div class="relative flex justify-between items-end -mt-12 mb-6">
                <img src="{{ dev.avatar_url }}" alt="{{ dev.github_username }}" class="w-32 h-32 rounded-full border-4 border-white dark:border-slate-800 bg-white shadow-lg">
                <div class="flex gap-3">
                    <a href="https://github.com/{{ dev.github_username }}" class="px-6 py-2 bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold rounded-xl hover:opacity-90 transition-opacity">
                        GitHub Profile
                    </a>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                    <h1 class="text-3xl font-extrabold mb-1">{{ dev.name }}</h1>
                    <p class="text-primary font-medium text-lg mb-4">@{{ dev.github_username }}</p>
                    <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-6">
                        {{ dev.bio or "No bio available." }}
                    </p>
                    
                    <div class="flex flex-wrap gap-4 text-sm text-gray-500">
                        {% if dev.location %}
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            {{ dev.location }}
                        </div>
                        {% endif %}
                        {% if dev.company %}
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                            {{ dev.company }}
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="bg-gray-50 dark:bg-slate-900/50 rounded-2xl p-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <div class="text-2xl font-bold">{{ dev.activity_score }}</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Activity Score</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold">{{ dev.followers | localeString }}</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Followers</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold">{{ dev.total_stars | localeString }}</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Total Stars</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold">{{ dev.public_repos }}</div>
                            <div class="text-xs text-gray-400 uppercase tracking-wider">Repositories</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <section>
            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4m-4 4l4 4m-4 4l4 4m-4-12l-4-4m4 4l-4 4m4 4l-4 4"></path></svg>
                Top Repositories
            </h2>
            <div class="space-y-4">
                {% for repo in dev.top_repos %}
                <div class="p-5 rounded-2xl border border-gray-100 dark:border-gray-700 bg-white dark:bg-slate-800">
                    <div class="flex justify-between items-start mb-2">
                        <a href="{{ repo.url }}" class="font-bold hover:text-primary transition-colors">{{ repo.name }}</a>
                        <div class="flex items-center gap-3 text-sm text-gray-500">
                            <span class="flex items-center gap-1">★ {{ repo.stars }}</span>
                            <span class="flex items-center gap-1">⑂ {{ repo.forks }}</span>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3">{{ repo.description }}</p>
                    {% if repo.language %}
                    <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs rounded-md">
                        {{ repo.language }}
                    </span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>

        <section>
            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                Languages
            </h2>
            <div class="flex flex-wrap gap-3 mb-8">
                {% for lang in dev.all_languages %}
                <a href="/languages/{{ lang | slugifyLang }}/" class="px-4 py-2 rounded-xl bg-primary/5 text-primary hover:bg-primary/10 border border-primary/10 transition-colors font-medium">
                    {{ lang }}
                </a>
                {% endfor %}
            </div>

            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Recent Activity (90d)
            </h2>
            <div class="bg-gray-50 dark:bg-slate-900/50 p-6 rounded-2xl">
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <div class="text-3xl font-black text-primary">{{ dev.contributions_last_90d }}</div>
                        <div class="text-xs text-gray-500 uppercase">Contributions</div>
                    </div>
                    <div>
                        <div class="text-3xl font-black text-secondary">{{ dev.prs_last_90d }}</div>
                        <div class="text-xs text-gray-500 uppercase">Pull Requests</div>
                    </div>
                    <div>
                        <div class="text-3xl font-black text-blue-500">{{ dev.commits_last_90d }}</div>
                        <div class="text-xs text-gray-500 uppercase">Commits</div>
                    </div>
                    <div>
                        <div class="text-3xl font-black text-yellow-500">{{ dev.reviews_last_90d }}</div>
                        <div class="text-xs text-gray-500 uppercase">Code Reviews</div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

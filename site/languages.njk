---
layout: base.njk
pagination:
    data: languages
    size: 1
    alias: lang
permalink: "/languages/{{ lang.slug }}/"
eleventyComputed:
    title: "{{ lang.name }} Developers in Bangladesh"
---

<div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
        <a href="/languages/" class="text-gray-500 hover:text-primary transition-colors">Languages</a>
        <span class="text-gray-300">/</span>
        <h1 class="text-4xl font-black">{{ lang.name }}</h1>
    </div>
    <p class="text-xl text-gray-600 dark:text-gray-400">
        Showing {{ lang.count }} developers who use {{ lang.name }}.
    </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for dev in lang.devs | sortBy("activity_score") %}
        <a href="/dev/{{ dev.github_username | lower }}/" class="group block p-6 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary transition-all hover:shadow-lg bg-white dark:bg-slate-800">
            <div class="flex items-center gap-4 mb-4">
                <img src="{{ dev.avatar_url }}" alt="{{ dev.github_username }}" class="w-16 h-16 rounded-full border-2 border-primary/20 group-hover:scale-105 transition-transform">
                <div>
                    <h3 class="font-bold text-lg group-hover:text-primary transition-colors">{{ dev.name }}</h3>
                    <p class="text-gray-500 text-sm">@{{ dev.github_username }}</p>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-2 text-center text-sm border-t border-gray-100 dark:border-gray-700 pt-4">
                <div>
                    <div class="font-bold">{{ dev.activity_score }}</div>
                    <div class="text-xs text-gray-400">Score</div>
                </div>
                <div>
                    <div class="font-bold">{{ dev.followers }}</div>
                    <div class="text-xs text-gray-400">Followers</div>
                </div>
                <div>
                    <div class="font-bold">{{ dev.total_stars }}</div>
                    <div class="text-xs text-gray-400">Stars</div>
                </div>
            </div>
        </a>
    {% endfor %}
</div>
